{
    // GPT routing preset on the codefast Codex Unlimited daily package (`bun scripts/install.ts --preset gpt-unlimited`).
    // Requests are uncounted but capped at 4 concurrent per user, so one lane and two workers per wave: a main or lane
    // session plus its workers stays within four streams. That endpoint serves gpt-6-astra and the gpt-5.6 family only.
    // Each chain falls back to a second GPT entry, then to the head of its default chain (Opus for the
    // oracle and the plan-reviewer).
    "title": "codefast-gpt-unlimited/gpt-5.6-luna#low",
    "maxLanes": 1,
    "maxParallel": 2,
    "tiers": {
        "main": [
            "codefast-gpt-unlimited/gpt-5.6-sol#high",
            "codefast-gpt-unlimited/gpt-5.6-terra#high",
            "codefast-glm/glm-5.3#high"
        ],
        "oracle": [
            "codefast-gpt-unlimited/gpt-6-astra#high",
            "codefast-gpt-unlimited/gpt-5.6-sol#xhigh",
            "anthropic/claude-opus-5-5#high"
        ],
        "plan-reviewer": [
            "codefast-gpt-unlimited/gpt-5.6-sol#high",
            "codefast-gpt-unlimited/gpt-6-astra#medium",
            "anthropic/claude-opus-5-5#medium"
        ],
        "design-director": [
            "codefast-gpt-unlimited/gpt-5.6-sol#high",
            "codefast-gpt-unlimited/gpt-6-astra#medium",
            "anthropic/claude-opus-5-5#medium"
        ],
        "plan-code-review": [
            "codefast-gpt-unlimited/gpt-6-astra#high",
            "codefast-gpt-unlimited/gpt-5.6-sol#xhigh",
            "codefast-glm/glm-5.3#max"
        ],
        "plan-worker-senior": [
            "codefast-gpt-unlimited/gpt-5.6-sol#xhigh",
            "codefast-gpt-unlimited/gpt-6-astra#medium",
            "codefast-glm/glm-5.3#max"
        ],
        "plan-worker-junior-high": [
            "codefast-gpt-unlimited/gpt-5.6-terra#high",
            "codefast-gpt-unlimited/gpt-5.6-sol#medium",
            "codefast-deepseek/deepseek-v4.1-flash-1017#high"
        ],
        "plan-worker-junior": [
            "codefast-gpt-unlimited/gpt-5.6-terra#medium",
            "codefast-gpt-unlimited/gpt-5.6-sol#medium",
            "codefast-deepseek/deepseek-v4.1-flash-1017#high"
        ],
        "plan-worker-quick": [
            "codefast-gpt-unlimited/gpt-5.6-luna#medium",
            "codefast-gpt-unlimited/gpt-5.6-terra#low",
            "codefast-deepseek/deepseek-v4.1-flash-1017#low"
        ],
        "explore": [
            "codefast-gpt-unlimited/gpt-5.6-luna#low",
            "codefast-gpt-unlimited/gpt-5.6-terra#low",
            "codefast-deepseek/deepseek-v4.1-flash-1017#low"
        ],
        "librarian": [
            "codefast-gpt-unlimited/gpt-5.6-luna#high",
            "codefast-gpt-unlimited/gpt-5.6-terra#medium",
            "codefast-deepseek/deepseek-v4.1-flash-1017#high"
        ],
        "qa-tester": [
            "codefast-gpt-unlimited/gpt-5.6-terra#medium",
            "codefast-gpt-unlimited/gpt-5.6-luna#high",
            "codefast-deepseek/deepseek-v4.1-flash-1017#high"
        ],
        "lane": [
            "codefast-gpt-unlimited/gpt-5.6-sol#high",
            "codefast-gpt-unlimited/gpt-5.6-terra#high",
            "codefast-glm/glm-5.3#high"
        ],
        "auto-verifier": [
            "codefast-gpt-unlimited/gpt-6-astra#high",
            "codefast-gpt-unlimited/gpt-5.6-sol#xhigh",
            "codefast-kimi/kimi-k3#max"
        ]
    }
}
