{
    // Balanced routing preset. A tier maps to an ordered fallback chain of `provider/model#variant`;
    // the first entry is the primary, the rest are tried in order when the one before it fails.
    "tiers": {
        "main": ["opencode-go/glm-5.3#high", "opencode-go/kimi-k3#high", "opencode-go/deepseek-v4-pro#high"],
        "oracle": ["opencode-go/kimi-k3#max", "opencode-go/glm-5.3#max", "opencode-go/deepseek-v4-pro#max"],
        "plan-reviewer": ["opencode-go/glm-5.3#max", "opencode-go/kimi-k3#high", "opencode-go/deepseek-v4-pro#max"],
        "plan-code-review": ["opencode-go/kimi-k3#high", "opencode-go/glm-5.3#max", "opencode-go/deepseek-v4-pro#max"],
        "plan-worker-senior": [
            "opencode-go/kimi-k3#high",
            "opencode-go/glm-5.3#max",
            "opencode-go/deepseek-v4-pro#max"
        ],
        "plan-worker-junior-high": [
            "opencode-go/glm-5.3#high",
            "opencode-go/kimi-k2.7-code",
            "opencode-go/deepseek-v4-pro#high"
        ],
        "plan-worker-junior": [
            "opencode-go/kimi-k2.7-code",
            "opencode-go/glm-5.3#high",
            "opencode-go/deepseek-v4-pro#high"
        ],
        "plan-worker-quick": [
            "opencode-go/glm-5.3-flash",
            "opencode-go/deepseek-v4.1-flash",
            "opencode-go/gpt-6-luna#low"
        ],
        "explore": ["opencode-go/deepseek-v4.1-flash", "opencode-go/glm-5.3-flash", "opencode-go/gpt-6-luna#low"],
        "librarian": ["opencode-go/deepseek-v4-pro#high", "opencode-go/glm-5.3#high", "opencode-go/gpt-6-luna#medium"],
        "qa-tester": ["opencode-go/glm-5.3#high", "opencode-go/kimi-k2.7-code", "opencode-go/deepseek-v4-pro#high"],
        "title": ["opencode-go/glm-5.3-flash#low", "opencode-go/gpt-6-luna#low"]
    },
    "cooldownSeconds": 30,
    "retryOn": [429, 500, 502, 503, 504],
    "retryAttempts": 2
}
