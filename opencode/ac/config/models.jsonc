{
    // Routing. A tier maps to an ordered fallback chain of `provider/model#variant`; the first entry is the
    // primary, the rest are tried in order when the one before it fails. One provider serves every chain:
    // `apimaster` (apimaster.ai, billed per token), with three models declared in templates/opencode.jsonc with
    // low, medium and high reasoning variants.
    //
    // Prices per million input and output tokens (GET https://apimaster.ai/api/pricing, 2026-11-02): gpt-6.1-sol 2 and
    // 10, gpt-6-astra 10 and 50, gpt-6-luna 0.10 and 0.50. Effort costs tokens, so no chain goes above high. On the
    // Artificial Analysis Coding Agent Index gpt-6-astra scores 54.7 and gpt-6.1-sol 54.1 at max effort, at about
    // 8.11 and 1.68 dollars a task (the index's token counts at 90% cached input), so astra is never a first rung: it
    // is the fallback for a model-level failure of sol, at an effort one step down (Artificial Analysis Intelligence
    // Index, astra at medium 51 against sol at high 50; astra at low 43 against sol at medium 46).
    //
    // The tiers keep the three Claude Code ac shapes. Opus-shaped tiers (main, oracle, plan-code-review,
    // plan-worker-senior, auto-verifier) take gpt-6.1-sol at high. Sonnet-shaped tiers (the other workers, the plan
    // reviewer, librarian, qa-tester, lane) take gpt-6.1-sol at medium: Intelligence Index 46, above Sonnet 5.5 at
    // the high effort Claude Code gives it (41). design-director is Opus at medium in Claude Code (Intelligence Index
    // 48), which sol at medium (46) matches. Haiku-shaped tiers (quick, explore) take
    // gpt-6-luna, a twentieth of the sol price; their fallback is gpt-6.1-sol at low (Intelligence Index 35 against
    // luna's 28 at max).
    "tiers": {
        "main": [
            "apimaster/gpt-6.1-sol#high",
            "apimaster/gpt-6-astra#medium"
        ],
        "oracle": [
            "apimaster/gpt-6.1-sol#high",
            "apimaster/gpt-6-astra#medium"
        ],
        "plan-reviewer": [
            "apimaster/gpt-6.1-sol#medium",
            "apimaster/gpt-6-astra#low"
        ],
        "design-director": [
            "apimaster/gpt-6.1-sol#medium",
            "apimaster/gpt-6-astra#low"
        ],
        "plan-code-review": [
            "apimaster/gpt-6.1-sol#high",
            "apimaster/gpt-6-astra#medium"
        ],
        "plan-worker-senior": [
            "apimaster/gpt-6.1-sol#high",
            "apimaster/gpt-6-astra#medium"
        ],
        "plan-worker-junior-high": [
            "apimaster/gpt-6.1-sol#medium",
            "apimaster/gpt-6-astra#low"
        ],
        "plan-worker-junior": [
            "apimaster/gpt-6.1-sol#medium",
            "apimaster/gpt-6-astra#low"
        ],
        "plan-worker-quick": [
            "apimaster/gpt-6-luna#medium",
            "apimaster/gpt-6.1-sol#low"
        ],
        "explore": [
            "apimaster/gpt-6-luna#low",
            "apimaster/gpt-6.1-sol#low"
        ],
        "librarian": [
            "apimaster/gpt-6.1-sol#medium",
            "apimaster/gpt-6-astra#low"
        ],
        "qa-tester": [
            "apimaster/gpt-6.1-sol#medium",
            "apimaster/gpt-6-astra#low"
        ],
        // A coordinate lane orchestrates one bundle's plan and execute runs, the main session's job inside a
        // worktree; it is Sonnet-shaped in the Claude Code ac plugin and keeps that shape here.
        "lane": [
            "apimaster/gpt-6.1-sol#medium",
            "apimaster/gpt-6-astra#low"
        ],
        "auto-verifier": [
            "apimaster/gpt-6.1-sol#high",
            "apimaster/gpt-6-astra#medium"
        ]
    },
    "cooldownSeconds": 30,
    "retryOn": [429, 500, 502, 503, 504],
    // Non-429 retryable statuses switch model at this attempt, counted per model: the host retry carries on
    // after a switch, on the new model.
    "retryAttempts": 3,
    // A 429 is an RPM limit that clears on its own, so a rate-limited model is retried on this schedule before the
    // chain moves on, in chain order, and the next entry starts the schedule again: every retry up to `through`
    // waits `seconds`. 30 retries, about 4 minutes per model. The host stops a step after 10 retries; a main session
    // or a lane then gets a continue message carrying the count on, and a failed subagent answers `wait:<seconds>`
    // from ac_fallback_next until its model has spent the schedule.
    "rateLimitBackoff": [
        { "through": 3, "seconds": 1 },
        { "through": 5, "seconds": 2 },
        { "through": 10, "seconds": 3 },
        { "through": 15, "seconds": 5 },
        { "through": 20, "seconds": 10 },
        { "through": 30, "seconds": 15 }
    ],
    // Providers behind one shared rate limit, for the skills' parallel caps. apimaster publishes no request limit
    // for this key, so none is declared and the plugin paces nothing (`rateLimits` is empty); a 429 is still
    // retried on the schedule above.
    "groups": {},
    // Default cap on ac workers running at once in an execute wave (--max-parallel overrides it), and on coordinate
    // lanes working at once per coordinator. Both are conservative defaults: the gateway's concurrency limit is
    // unknown, and every lane runs its own workers.
    "maxParallel": 3,
    "rateLimits": {},
    "maxLanes": 2
}
