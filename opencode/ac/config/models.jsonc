{
    // Routing preset. A tier maps to an ordered fallback chain of `provider/model#variant`;
    // the first entry is the primary, the rest are tried in order when the one before it fails.
    // codefast-* are the unlimited codefast.app endpoints (one provider per endpoint, defined in
    // templates/opencode.jsonc with low/high/max reasoning variants). Four families only:
    // - GLM-5.3: main session and plan-worker-senior (agentic coder trained against a Claude Code shaped harness, ZCode).
    // - Kimi K3: oracle and plan-reviewer, a different family from whoever produced the artifact
    //   (planner GLM -> plan-reviewer Kimi; main GLM -> oracle Kimi); workers run DeepSeek, so plan-code-review is GLM.
    // - DeepSeek V4.1 Flash 1017: Sonnet- and Haiku-shaped workhorse (Artificial Analysis Intelligence Index 45 =
    //   GLM-5.3, Kimi K3 44, Qwen3.8 Flash 40; speed class 4/4 vs GLM 3/4, Qwen 2/4, Kimi 1/4; operator test 12/12).
    // - Qwen 3.8 Flash: last codefast fallback (the title model is set in templates/opencode.jsonc, not routed here).
    // The codefast entries sit inside the one codefast rate-limit group, so they mainly cover model-specific errors
    // (5xx, malformed output); a group-wide 429 waits (rateLimitAttempts). Every chain then ends with one Claude rung
    // on the built-in `anthropic` provider (API key, catalogue variants), outside that group, so a codefast outage
    // still has somewhere to go. The rung follows the Claude Code ac mapping: Opus 5.5 for the Opus-shaped tiers
    // (main, oracle, plan-code-review at high; plan-reviewer, plan-worker-senior at medium), Sonnet 5.5 at high for
    // the Sonnet-shaped ones, Haiku 5.5 at medium for plan-worker-quick and explore.
    // config/presets/claude.jsonc is the opposite routing, Claude first and codefast after it
    // (scripts/install.ts --preset claude).
    "tiers": {
        "main": [
            "codefast-glm/glm-5.3#high",
            "codefast-deepseek/deepseek-v4.1-flash-1017#high",
            "codefast-kimi/kimi-k3#high",
            "anthropic/claude-opus-5-5#high"
        ],
        "oracle": [
            "codefast-kimi/kimi-k3#max",
            "codefast-deepseek/deepseek-v4.1-flash-1017#max",
            "codefast-glm/glm-5.3#max",
            "anthropic/claude-opus-5-5#high"
        ],
        "plan-reviewer": [
            "codefast-kimi/kimi-k3#high",
            "codefast-deepseek/deepseek-v4.1-flash-1017#max",
            "codefast-glm/glm-5.3#max",
            "anthropic/claude-opus-5-5#medium"
        ],
        "plan-code-review": [
            "codefast-glm/glm-5.3#max",
            "codefast-kimi/kimi-k3#high",
            "codefast-deepseek/deepseek-v4.1-flash-1017#max",
            "anthropic/claude-opus-5-5#high"
        ],
        "plan-worker-senior": [
            "codefast-glm/glm-5.3#max",
            "codefast-deepseek/deepseek-v4.1-flash-1017#max",
            "codefast-kimi/kimi-k3#high",
            "anthropic/claude-opus-5-5#medium"
        ],
        "plan-worker-junior-high": [
            "codefast-deepseek/deepseek-v4.1-flash-1017#high",
            "codefast-glm/glm-5.3#high",
            "codefast-qwen/qwen3.8-flash#high",
            "anthropic/claude-sonnet-5-5#high"
        ],
        "plan-worker-junior": [
            "codefast-deepseek/deepseek-v4.1-flash-1017#high",
            "codefast-glm/glm-5.3#high",
            "codefast-qwen/qwen3.8-flash#high",
            "anthropic/claude-sonnet-5-5#high"
        ],
        "plan-worker-quick": [
            "codefast-deepseek/deepseek-v4.1-flash-1017#low",
            "codefast-qwen/qwen3.8-flash#low",
            "codefast-deepseek/deepseek-v4.1-flash#low",
            "anthropic/claude-haiku-5-5#medium"
        ],
        "explore": [
            "codefast-deepseek/deepseek-v4.1-flash-1017#low",
            "codefast-qwen/qwen3.8-flash#low",
            "codefast-deepseek/deepseek-v4.1-flash#low",
            "anthropic/claude-haiku-5-5#medium"
        ],
        "librarian": [
            "codefast-deepseek/deepseek-v4.1-flash-1017#high",
            "codefast-kimi/kimi-k3#high",
            "codefast-qwen/qwen3.8-flash#high",
            "anthropic/claude-sonnet-5-5#high"
        ],
        "qa-tester": [
            "codefast-deepseek/deepseek-v4.1-flash-1017#high",
            "codefast-glm/glm-5.3#high",
            "codefast-qwen/qwen3.8-flash#high",
            "anthropic/claude-sonnet-5-5#high"
        ]
    },
    "cooldownSeconds": 30,
    "retryOn": [429, 500, 502, 503, 504],
    // Non-429 retryable statuses switch model at this attempt, counted per model: the host retry carries on
    // after a switch, on the new model.
    "retryAttempts": 3,
    // A 429 is an RPM limit that clears within seconds, so the host keeps retrying (it honours retry-after)
    // until this attempt before the fallback acts.
    "rateLimitAttempts": 10,
    // Providers behind one shared rate limit. A failed 429 cools the whole group down, so the fallback skips
    // to an entry outside it. A provider not listed here is its own group. All four codefast endpoints
    // share one group:unlimited limit (25 RPM).
    "groups": {
        "codefast": ["codefast-glm", "codefast-kimi", "codefast-deepseek", "codefast-qwen"]
    },
    // Default cap on ac workers running at once in an execute wave (--max-parallel overrides it). Every turn of a
    // worker spends several requests of the one shared 25 RPM group, so a wider wave mostly waits on 429s.
    "maxParallel": 3
}
