{
    // Routing preset. A tier maps to an ordered fallback chain of `provider/model#variant`;
    // the first entry is the primary, the rest are tried in order when the one before it fails.
    // codefast-* are the unlimited codefast.app endpoints (one provider per endpoint, defined in
    // templates/opencode.jsonc with low/high/max reasoning variants). Four families only:
    // - GLM-5.3: main session and plan-worker-senior (agentic coder trained against a Claude Code shaped harness, ZCode).
    // - Kimi K3: the first codefast rung of oracle and plan-reviewer (both lead with Opus, see below), a different
    //   family from whoever produced the artifact; workers run DeepSeek, so plan-code-review is GLM.
    // - DeepSeek V4.1 Flash 1017: Sonnet- and Haiku-shaped workhorse (Artificial Analysis Intelligence Index 45 =
    //   GLM-5.3, Kimi K3 44, Qwen3.8 Flash 40; speed class 4/4 vs GLM 3/4, Qwen 2/4, Kimi 1/4; operator test 12/12).
    // - Qwen 3.8 Flash: last codefast fallback (the title model is set in templates/opencode.jsonc, not routed here).
    // The codefast entries sit inside the one codefast rate-limit group; a 429 is retried on one model through the
    // whole rateLimitBackoff schedule before the chain moves to the next entry. Every other chain then ends with one
    // Claude rung on the built-in `anthropic` provider (API key, catalogue variants), outside that group, so a codefast
    // outage still has somewhere to go; oracle and plan-reviewer lead with it instead. The rung follows the Claude
    // Code ac mapping: Opus 5.5 for the Opus-shaped tiers (main, oracle, plan-code-review at high; plan-reviewer,
    // plan-worker-senior at medium), Sonnet 5.5 at high for the Sonnet-shaped ones, Haiku 5.5 at medium for
    // plan-worker-quick and explore.
    // config/presets/claude.jsonc is the opposite routing, Claude first and codefast after it
    // (scripts/install.ts --preset claude).
    "tiers": {
        "main": [
            "codefast-glm/glm-5.3#high",
            "codefast-deepseek/deepseek-v4.1-flash-1017#high",
            "codefast-kimi/kimi-k3#high",
            "anthropic/claude-opus-5-5#high"
        ],
        // The two review gates lead with Opus on the Claude API, at the Claude Code ac efforts (oracle high,
        // plan-reviewer medium): they decide whether a plan or a change goes ahead. When the Claude account is
        // out of credit, over its spend limit or its key is refused, the fallback leaves it for the codefast rungs.
        "oracle": [
            "anthropic/claude-opus-5-5#high",
            "codefast-kimi/kimi-k3#max",
            "codefast-deepseek/deepseek-v4.1-flash-1017#max",
            "codefast-glm/glm-5.3#max"
        ],
        "plan-reviewer": [
            "anthropic/claude-opus-5-5#medium",
            "codefast-kimi/kimi-k3#high",
            "codefast-deepseek/deepseek-v4.1-flash-1017#max",
            "codefast-glm/glm-5.3#max"
        ],
        "plan-code-review": [
            "codefast-glm/glm-5.3#max",
            "codefast-kimi/kimi-k3#high",
            "codefast-deepseek/deepseek-v4.1-flash-1017#max",
            "anthropic/claude-opus-5-5#high"
        ],
        "plan-worker-senior": [
            "codefast-glm/glm-5.3#max",
            "codefast-deepseek/deepseek-v4.1-flash-1017#max",
            "codefast-kimi/kimi-k3#high",
            "anthropic/claude-opus-5-5#medium"
        ],
        "plan-worker-junior-high": [
            "codefast-deepseek/deepseek-v4.1-flash-1017#high",
            "codefast-glm/glm-5.3#high",
            "codefast-qwen/qwen3.8-flash#high",
            "anthropic/claude-sonnet-5-5#high"
        ],
        "plan-worker-junior": [
            "codefast-deepseek/deepseek-v4.1-flash-1017#high",
            "codefast-glm/glm-5.3#high",
            "codefast-qwen/qwen3.8-flash#high",
            "anthropic/claude-sonnet-5-5#high"
        ],
        "plan-worker-quick": [
            "codefast-deepseek/deepseek-v4.1-flash-1017#low",
            "codefast-qwen/qwen3.8-flash#low",
            "codefast-deepseek/deepseek-v4.1-flash#low",
            "anthropic/claude-haiku-5-5#medium"
        ],
        "explore": [
            "codefast-deepseek/deepseek-v4.1-flash-1017#low",
            "codefast-qwen/qwen3.8-flash#low",
            "codefast-deepseek/deepseek-v4.1-flash#low",
            "anthropic/claude-haiku-5-5#medium"
        ],
        "librarian": [
            "codefast-deepseek/deepseek-v4.1-flash-1017#high",
            "codefast-kimi/kimi-k3#high",
            "codefast-qwen/qwen3.8-flash#high",
            "anthropic/claude-sonnet-5-5#high"
        ],
        "qa-tester": [
            "codefast-deepseek/deepseek-v4.1-flash-1017#high",
            "codefast-glm/glm-5.3#high",
            "codefast-qwen/qwen3.8-flash#high",
            "anthropic/claude-sonnet-5-5#high"
        ],
        // A coordinate lane orchestrates one bundle's plan and execute runs, the main session's job inside a
        // worktree, so it takes the main chain's builder. The verifier judges finished work against frozen
        // criteria, so it takes the independent reviewer family first, as the oracle does.
        "lane": [
            "codefast-glm/glm-5.3#high",
            "codefast-kimi/kimi-k3#high",
            "codefast-deepseek/deepseek-v4.1-flash-1017#high",
            "anthropic/claude-opus-5-5#high"
        ],
        "auto-verifier": [
            "codefast-kimi/kimi-k3#max",
            "codefast-glm/glm-5.3#max",
            "codefast-deepseek/deepseek-v4.1-flash-1017#max",
            "anthropic/claude-opus-5-5#high"
        ]
    },
    "cooldownSeconds": 30,
    "retryOn": [429, 500, 502, 503, 504],
    // Non-429 retryable statuses switch model at this attempt, counted per model: the host retry carries on
    // after a switch, on the new model.
    "retryAttempts": 3,
    // A 429 is an RPM limit that clears on its own, so a rate-limited model is retried on this schedule before the
    // chain moves on, in chain order, and the next entry starts the schedule again: every retry up to `through`
    // waits `seconds`. 30 retries, about 4 minutes per model. The host stops a step after 10 retries; a main session
    // or a lane then gets a continue message carrying the count on, and a failed subagent answers `wait:<seconds>`
    // from ac_fallback_next until its model has spent the schedule.
    "rateLimitBackoff": [
        { "through": 3, "seconds": 1 },
        { "through": 5, "seconds": 2 },
        { "through": 10, "seconds": 3 },
        { "through": 15, "seconds": 5 },
        { "through": 20, "seconds": 10 },
        { "through": 30, "seconds": 15 }
    ],
    // Providers behind one shared rate limit. A model that spent the 429 schedule cools its whole group down, which
    // keeps a session from switching back onto it at once and caps the skills' parallel work; the chain itself
    // moves on in order. A provider not listed here is its own group. All four codefast endpoints
    // share one group:unlimited limit (25 RPM). The GPT unlimited endpoint is listed as a group of its own so the
    // skills' shared-limit cap applies under the gpt-unlimited preset too: it allows 4 concurrent requests.
    "groups": {
        "codefast": ["codefast-glm", "codefast-kimi", "codefast-deepseek", "codefast-qwen"],
        "codefast-gpt-unlimited": ["codefast-gpt-unlimited"]
    },
    // Default cap on ac workers running at once in an execute wave (--max-parallel overrides it). Every turn of a
    // worker spends several requests of the one shared 25 RPM group, so a wider wave mostly waits on 429s.
    "maxParallel": 3,
    // Request starts per minute the plugin lets through per rate-limit group, for every session of the service at once
    // (each lane, worker and main session of every project): requests beyond it wait in one queue, in arrival order,
    // instead of being sent to fail. codefast's limit is 25 per rolling minute for the whole account
    // (`rpm_limit: 25`, `rate_limit_scope: "group:unlimited"`), and a burst of quick retries over it also earns a
    // temporary Cloudflare ban (error 1015), so pacing at the limit is both the fastest rate and the safe one.
    "rateLimits": {
        "codefast": 25
    },
    // Cap on coordinate lanes working at once per coordinator, reported by ac_lane_start and kept by the coordinate
    // skill. Each lane runs its own workers, so lanes multiply the load on that same 25 RPM group.
    "maxLanes": 2
}
