{
    // Global opencode v2 config for the ac port. scripts/install.ts renders it to ~/.config/opencode/opencode.jsonc,
    // replacing <repo> with this checkout. Secrets stay in the environment, referenced as {env:NAME}.
    "$schema": "https://opencode.ai/config.json",
    "model": "apimaster/gpt-6.1-sol#high",
    "default_agent": "build",
    "update": "notify",
    "snapshots": false,
    // The ac MCP server serves web-fetch, web-search, web-code-search, resolve-library and search-docs instead.
    "websearch": false,

    "agents": {
        "build": { "model": "apimaster/gpt-6.1-sol#high" },
        // The ac plugin owns planning and exploration (ac/plan, ac/explore); the stock agents would shadow them.
        "plan": { "disabled": true },
        "explore": { "disabled": true },
        "general": { "disabled": true },
        "title": { "model": "apimaster/gpt-6-luna#low" }
    },

    // Last matching rule wins. These bind the built-in agents; a markdown agent gets them first and its own rules
    // after, so every ac agent (opencode/ac/agents/*.md) ends its permissions with its own copy of the protections.
    "permissions": [
        { "action": "edit", "resource": "~/.claude/projects/**", "effect": "deny" },
        { "action": "opencode_list_mcp_resources", "resource": "*", "effect": "deny" },
        { "action": "opencode_read_mcp_resource", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "report", "effect": "deny" },
        { "action": "read", "resource": "*.dev.vars", "effect": "ask" }
    ],

    // Only the one provider the ac chains route to may serve a turn. When a session's model briefly fails to resolve
    // (a config or plugin reload), opencode falls back to the first available model (core/src/model.ts:271-275);
    // on 2026-10-23 that put three lane turns on a connected OpenRouter account, and on 2026-10-24 on paid Opus.
    // Last matching rule wins.
    "policies": [
        { "action": "provider.use", "resource": "*", "effect": "deny" },
        { "action": "provider.use", "resource": "apimaster", "effect": "allow" }
    ],

    // opencode reads AGENTS.md only; the project's Claude Code memory files ride in as configured instructions.
    "instructions": ["CLAUDE.md", "CLAUDE.local.md", ".claude/CLAUDE.md"],
    "skills": ["<repo>/opencode/ac/skills"],

    "mcp": {
        "servers": {
            "ac": {
                "type": "local",
                "command": ["node", "<repo>/plugins/ac/cli/ac.js", "mcp", "--client", "opencode"],
                "codemode": false,
                // The shared background service does not inherit the shell environment, so the proxy's
                // credentials are handed over explicitly.
                "environment": {
                    "KODIZM_MCP_TOKEN": "{env:KODIZM_MCP_TOKEN}",
                    "KODIZM_MCP_URL": "{env:KODIZM_MCP_URL}"
                }
            },
            // The operator's own server, added on this machine; kept here so a re-install does not drop it.
            "rea": {
                "type": "local",
                "command": ["npx", "-y", "rea-agents@6.7.0", "mcp"]
            }
        }
    },

    // The ac plugin composes the base prompt itself, so the built-in per-family prompts go off. The verbosity
    // plugin would also pin GPT text verbosity to low, cutting reviewer and oracle reports short next to the
    // other families; the ac overlays set the length instead.
    "plugins": [
        "*",
        "-opencode.prompt.verbosity",
        "-opencode.prompt.openai",
        "-opencode.prompt.kimi",
        "-opencode.prompt.anthropic",
        "-opencode.prompt.arcee",
        "-opencode.prompt.meta",
        { "package": "<repo>/opencode/ac" }
    ],

    // apimaster.ai, billed per token: each model at its list price per million input and output tokens (GET
    // https://apimaster.ai/api/pricing on 2026-11-02, before the gateway's group ratio of 1.05). Cached input costs
    // a twentieth of the input price on gpt-6.1-sol and a tenth on gpt-6-astra and gpt-6-luna. The same key also
    // serves Claude, Gemini and open models; only the three GPT models the chains use are declared, and the policy
    // above leaves every other provider off. The gateway lists the chat endpoint alone for them (/v1/responses
    // failed for gpt-6.1-sol and gpt-6-astra), so the openai-compatible chat provider is the one declared; a shell
    // tool turn ran on all three through opencode on 2026-11-02. A model the key has no balance for answers 403
    // insufficient_user_quota, on which the fallback cools that model alone for 30 minutes (src/fallback.ts
    // cooldownKey) while the other two stay usable. Effort is a body parameter and costs tokens, so only low, medium
    // and high are declared: xhigh and max were not run against the gateway. Context and output limits are the
    // ones another gateway listed for these models (apimaster publishes none), and 272K is the point where GPT
    // pricing tiers up.
    "providers": {
        "apimaster": {
            "name": "APIMaster",
            "package": "aisdk:@ai-sdk/openai-compatible",
            "settings": {
                "baseURL": "https://apimaster.ai/v1",
                "apiKey": "{env:APIMASTER_API_KEY}"
            },
            "models": {
                "gpt-6.1-sol": {
                    "name": "GPT-6.1 Sol",
                    "capabilities": {
                        "tools": true,
                        "input": ["text", "image"],
                        "output": ["text"],
                        "reasoning": { "supported": true, "effort": ["low", "medium", "high"] }
                    },
                    "limit": { "context": 272000, "output": 128000 },
                    "variants": [
                        { "id": "low", "body": { "reasoning_effort": "low" } },
                        { "id": "medium", "body": { "reasoning_effort": "medium" } },
                        { "id": "high", "body": { "reasoning_effort": "high" } }
                    ]
                },
                "gpt-6-astra": {
                    "name": "GPT-6 Astra",
                    "capabilities": {
                        "tools": true,
                        "input": ["text", "image"],
                        "output": ["text"],
                        "reasoning": { "supported": true, "effort": ["low", "medium", "high"] }
                    },
                    "limit": { "context": 272000, "output": 128000 },
                    "variants": [
                        { "id": "low", "body": { "reasoning_effort": "low" } },
                        { "id": "medium", "body": { "reasoning_effort": "medium" } },
                        { "id": "high", "body": { "reasoning_effort": "high" } }
                    ]
                },
                "gpt-6-luna": {
                    "name": "GPT-6 Luna",
                    "capabilities": {
                        "tools": true,
                        "input": ["text", "image"],
                        "output": ["text"],
                        "reasoning": { "supported": true, "effort": ["low", "medium", "high"] }
                    },
                    "limit": { "context": 272000, "output": 128000 },
                    "variants": [
                        { "id": "low", "body": { "reasoning_effort": "low" } },
                        { "id": "medium", "body": { "reasoning_effort": "medium" } },
                        { "id": "high", "body": { "reasoning_effort": "high" } }
                    ]
                }
            }
        }
    }
}
