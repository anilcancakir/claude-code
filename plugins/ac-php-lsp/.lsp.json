{
    "intelephense": {
        "command": "intelephense",
        "args": [
            "--stdio"
        ],
        "extensionToLanguage": {
            ".php": "php",
            ".phtml": "php"
        },
        "startupTimeout": 30000,
        "settings": {
            "intelephense": {
                "files": {
                    "exclude": [
                        "**/.git/**",
                        "**/.svn/**",
                        "**/.hg/**",
                        "**/CVS/**",
                        "**/.DS_Store/**",
                        "**/node_modules/**",
                        "**/bower_components/**",
                        "**/vendor/**/{Tests,tests}/**",
                        "**/.history/**",
                        "**/vendor/**/vendor/**",
                        "**/.claude/worktrees/**",
                        "**/build/**"
                    ]
                }
            }
        }
    }
}
