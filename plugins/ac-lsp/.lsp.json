{
    "intelephense": {
        "command": "node",
        "args": [
            "${CLAUDE_PLUGIN_ROOT}/bin/lsp-proxy.js",
            "--watch-root",
            "--ext",
            ".php",
            "--ext",
            ".phtml",
            "--",
            "intelephense",
            "--stdio"
        ],
        "extensionToLanguage": {
            ".php": "php",
            ".phtml": "php"
        },
        "startupTimeout": 30000,
        "settings": {
            "intelephense": {
                "files": {
                    "exclude": [
                        "**/.git/**",
                        "**/.svn/**",
                        "**/.hg/**",
                        "**/CVS/**",
                        "**/.DS_Store/**",
                        "**/node_modules/**",
                        "**/bower_components/**",
                        "**/vendor/**/{Tests,tests}/**",
                        "**/.history/**",
                        "**/vendor/**/vendor/**",
                        "**/.claude/worktrees/**",
                        "**/build/**"
                    ]
                },
                "diagnostics": {
                    "unusedSymbols": false
                }
            }
        }
    },
    "dart": {
        "command": "node",
        "args": [
            "${CLAUDE_PLUGIN_ROOT}/bin/lsp-proxy.js",
            "--",
            "dart",
            "language-server",
            "--protocol=lsp"
        ],
        "extensionToLanguage": {
            ".dart": "dart"
        },
        "startupTimeout": 60000
    }
}
