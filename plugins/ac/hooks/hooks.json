{
  "description": "ac plan-execution hooks: SessionStart surfaces active plan state (and, after a compaction, what compaction did to the skill bodies); Stop blocks a turn-ending attempt while an execute run is still in flight and guards autonomous mode completion (stop-guard-auto.sh); PreToolUse scopes subagent file edits to the active wave and steers native plan mode to /ac:plan, and guards Bash tool access in autonomous mode (pretooluse-bash-guard.sh) A second PreToolUse registration caps one ac:explore spawn's tool calls, scoped by the agent_type the harness supplies. Every hook fails open.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-start-plan-state.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/stop-guard.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/stop-guard-auto.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/pretooluse-file-scope.sh"
          }
        ]
      },
      {
        "matcher": "EnterPlanMode|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/pretooluse-plan-mode-block.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/pretooluse-bash-guard.sh"
          }
        ]
      },
      {
        "matcher": "Read|Bash|Grep|Glob|LSP",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/pretooluse-explore-budget.sh"
          }
        ]
      }
    ]
  }
}
