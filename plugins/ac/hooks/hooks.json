{
  "description": "ac plan-execution hooks: SessionStart surfaces active plan state (and, after a compaction, what compaction did to the skill bodies); Stop blocks a turn-ending attempt while an execute run is still in flight; PreToolUse scopes subagent file edits to the active wave and steers native plan mode to /ac:plan. Every hook fails open.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-start-plan-state.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/stop-guard.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/pretooluse-file-scope.sh"
          }
        ]
      },
      {
        "matcher": "EnterPlanMode|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/pretooluse-plan-mode-block.sh"
          }
        ]
      }
    ]
  }
}
